{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/boot/**",
              "components/brand/**",
              "components/chrome/**",
              "components/controls/**",
              "components/data/**",
              "components/query/**",
              "ui_kits/samaritan-console/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Share Tech Mono|Rajdhani|Montserrat|Inter|Open Sans|Syne|DM Mono))/i]",
        "message": "Font not provided by the design system. Available: Share Tech Mono, Rajdhani, Montserrat, Inter, Open Sans, Syne, DM Mono."
      },
      {
        "selector": "JSXOpeningElement[name.name='BootLine'] > JSXAttribute > JSXIdentifier[name!=/^(?:text|tone|key|ref|className|style|children)$/]",
        "message": "<BootLine> doesn't accept that prop. Declared props: text, tone."
      },
      {
        "selector": "JSXOpeningElement[name.name='BootLine'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:g|r|w)$/]",
        "message": "<BootLine> tone must be one of 'g' | 'r' | 'w'."
      },
      {
        "selector": "JSXOpeningElement[name.name='BrandMark'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|suffix|subscript|rule|triangle|glitch|period|className|style|key|ref|className|style|children)$/]",
        "message": "<BrandMark> doesn't accept that prop. Declared props: name, suffix, subscript, rule, triangle, glitch, period, className, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='ClassificationTag'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|className|style|key|ref|className|style|children)$/]",
        "message": "<ClassificationTag> doesn't accept that prop. Declared props: children, className, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='CornerBrackets'] > JSXAttribute > JSXIdentifier[name!=/^(?:corners|className|key|ref|className|style|children)$/]",
        "message": "<CornerBrackets> doesn't accept that prop. Declared props: corners, className."
      },
      {
        "selector": "JSXOpeningElement[name.name='DataRow'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|value|highlight|key|ref|className|style|children)$/]",
        "message": "<DataRow> doesn't accept that prop. Declared props: label, value, highlight."
      },
      {
        "selector": "JSXOpeningElement[name.name='GhostButton'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|onClick|className|style|key|ref|className|style|children)$/]",
        "message": "<GhostButton> doesn't accept that prop. Declared props: children, onClick, className, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='InfoField'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|children|value|className|key|ref|className|style|children)$/]",
        "message": "<InfoField> doesn't accept that prop. Declared props: label, children, value, className."
      },
      {
        "selector": "JSXOpeningElement[name.name='MapFrame'] > JSXAttribute > JSXIdentifier[name!=/^(?:src|title|height|children|className|key|ref|className|style|children)$/]",
        "message": "<MapFrame> doesn't accept that prop. Declared props: src, title, height, children, className."
      },
      {
        "selector": "JSXOpeningElement[name.name='OptionButton'] > JSXAttribute > JSXIdentifier[name!=/^(?:index|label|onClick|arrow|width|disabled|className|key|ref|className|style|children)$/]",
        "message": "<OptionButton> doesn't accept that prop. Declared props: index, label, onClick, arrow, width, disabled, className."
      },
      {
        "selector": "JSXOpeningElement[name.name='PersonContact'] > JSXAttribute > JSXIdentifier[name!=/^(?:kind|value|href|key|ref|className|style|children)$/]",
        "message": "<PersonContact> doesn't accept that prop. Declared props: kind, value, href."
      },
      {
        "selector": "JSXOpeningElement[name.name='ProgressLine'] > JSXAttribute > JSXIdentifier[name!=/^(?:running|value|duration|width|className|key|ref|className|style|children)$/]",
        "message": "<ProgressLine> doesn't accept that prop. Declared props: running, value, duration, width, className."
      },
      {
        "selector": "JSXOpeningElement[name.name='QueryLine'] > JSXAttribute > JSXIdentifier[name!=/^(?:text|typing|speed|jitter|label|prompt|onDone|className|key|ref|className|style|children)$/]",
        "message": "<QueryLine> doesn't accept that prop. Declared props: text, typing, speed, jitter, label, prompt, onDone, className."
      },
      {
        "selector": "JSXOpeningElement[name.name='SectionHeader'] > JSXAttribute > JSXIdentifier[name!=/^(?:tag|title|onBack|backLabel|className|key|ref|className|style|children)$/]",
        "message": "<SectionHeader> doesn't accept that prop. Declared props: tag, title, onBack, backLabel, className."
      },
      {
        "selector": "JSXOpeningElement[name.name='Shell'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|plate|contained|crt|className|style|key|ref|className|style|children)$/]",
        "message": "<Shell> doesn't accept that prop. Declared props: children, plate, contained, crt, className, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Stage'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|brackets|className|style|key|ref|className|style|children)$/]",
        "message": "<Stage> doesn't accept that prop. Declared props: children, brackets, className, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='StatusBar'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|live|clock|left|right|className|key|ref|className|style|children)$/]",
        "message": "<StatusBar> doesn't accept that prop. Declared props: label, live, clock, left, right, className."
      },
      {
        "selector": "JSXOpeningElement[name.name='StatusDot'] > JSXAttribute > JSXIdentifier[name!=/^(?:color|size|className|style|key|ref|className|style|children)$/]",
        "message": "<StatusDot> doesn't accept that prop. Declared props: color, size, className, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='StatusFooter'] > JSXAttribute > JSXIdentifier[name!=/^(?:items|date|locale|className|key|ref|className|style|children)$/]",
        "message": "<StatusFooter> doesn't accept that prop. Declared props: items, date, locale, className."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
